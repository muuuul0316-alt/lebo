# 乐播·龙虾脑 nginx 反代（含 WebSocket 升级）。放到 /etc/nginx/conf.d/lebo.conf。
# HTTPS 是硬要求：麦克风（getUserMedia）与浏览器 ASR 只在安全上下文可用，微信内也要求 https。
server {
  listen 80;
  server_name your.domain.com;
  # 上线后用 certbot 申请证书并改为 443/ssl；以下先给 80 便于联调
  location / {
    proxy_pass http://127.0.0.1:8620;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;        # WebSocket 升级
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;                        # 长任务/长连接
    client_max_body_size 600m;                       # VIP 包上限
  }
}
