[Unit]
Description=乐播·龙虾脑 服务端
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/lebo/server
# .env 由应用自身读取（server/src/config.js 会加载 /opt/lebo/.env），
# 不用 systemd EnvironmentFile，避免密钥含 # ! 等字符时解析失败。
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=3
# 限制重启频率：配置错误时会无限重启，既刷爆日志也拖垮机器
StartLimitIntervalSec=60
StartLimitBurst=5
# 交给 journald（自带轮转与容量上限），不要直接 append 到文件把磁盘写满
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
