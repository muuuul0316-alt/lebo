# ============================================================
# 乐播·龙虾脑 服务端配置
# 复制为 .env 并填入真实值。真实密钥严禁提交 Git。
# ============================================================

# ---- 基础 ----
PORT=8620
PUBLIC_BASE_URL=http://localhost:8620   # 对外访问地址（二维码里用），上线改为 https://你的域名
DATA_DIR=./data
UPLOAD_DIR=./uploads

# ---- 大模型主脑（火山方舟 ARK，豆包） ----
# 不填则自动进入 mock 模式（规则意图识别，可离线演示全部链路）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_CHAT_MODEL=doubao-seed-1-6-250615
# 多模态理解（图片/视频帧），没有单独开通就填同上
ARK_VISION_MODEL=doubao-seed-1-6-250615

# ---- 备用模型（阿里 DashScope，OpenAI 兼容） ----
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-long

# ---- 火山语音（TTS / ASR，独立于 ARK 的一套凭证） ----
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
VOLC_TTS_CLUSTER=volcano_tts
VOLC_TTS_VOICE=BV001_streaming
# 双人对话式讲解的第二音色
VOLC_TTS_VOICE_B=BV002_streaming

# ---- 阿里云无影云桌面（CUA 执行体） ----
# 独立 RAM 用户，最小 EDS 权限
WUYING_ACCESS_KEY_ID=
WUYING_ACCESS_KEY_SECRET=
WUYING_REGION=cn-shenzhen
WUYING_DESKTOP_ID=
WUYING_OFFICE_SITE_ID=

# 云桌面内 cua-agent 回连本服务时的共享令牌
CUA_AGENT_TOKEN=change-me

# ---- 演示片源（F-02 看电影 链路的合法演示内容） ----
# JSON 数组：[{"title":"...","url":"https://....mp4"}]
DEMO_MEDIA_JSON=
